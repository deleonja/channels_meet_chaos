Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rval", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rval", "[", 
    RowBox[{"hx_", ",", "hz_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"H", "=", 
        RowBox[{"IsingNNOpenHamiltonian", "[", 
         RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ",", "Heven",
        ",", "Hodd", ",", "evenval", ",", "oddval"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Heven", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H", ".", 
        "Beven"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Hodd", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H", ".", 
        "Bodd"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"evenval", "=", 
       RowBox[{"Eigenvalues", "[", "Heven", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"oddval", "=", 
       RowBox[{"Eigenvalues", "[", "Hodd", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"hx", ",", "hz", ",", 
        RowBox[{"MeanLevelSpacingRatio", "[", "evenval", "]"}], ",", 
        RowBox[{"MeanLevelSpacingRatio", "[", "oddval", "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9562637075971947`*^9, 3.956263862600662*^9}},
 CellLabel->
  "In[626]:=",ExpressionUUID->"0b232cf3-7d75-4fb6-93c0-71a694570598"],

