Cell[BoxData[{
 RowBox[{
  RowBox[{"basis", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ToIndex", "[", "state_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"state", ",", "2"}], "]"}], "+", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permutation", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ToIndex", "[", 
      RowBox[{"Reverse", "[", 
       RowBox[{"basis", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permCycles", "=", 
   RowBox[{"PermutationCycles", "[", "permutation", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"PermutationMatrix", "[", 
    RowBox[{"permCycles", ",", 
     RowBox[{"2", "^", "L"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evalR", ",", "evecR"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "R", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evenBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "evenIndices", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "oddIndices", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Beven", "=", 
   RowBox[{"Transpose", "[", "evenBasis", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bodd", "=", 
   RowBox[{"Transpose", "[", "oddBasis", "]"}]}], ";"}]}], "Input",
