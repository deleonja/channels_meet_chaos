Cell[CellGroupData[{

Cell["Spectrum", "Chapter",
 CellChangeTimes->{{3.953667160277186*^9, 
  3.953667161401022*^9}},ExpressionUUID->"33c649a9-4a04-4183-a382-\
c40ba2f2559f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}]], "Input",
 CellChangeTimes->{{3.953693881518136*^9, 3.953693883529711*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"afe65c2f-8298-402c-9dec-a0b8f1c665cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"J", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"IsingNNOpenHamiltonian", "[", 
    RowBox[{"h", ",", "g", ",", "J", ",", "L"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.953667167342494*^9, 3.953667183048272*^9}, {
  3.953673732659031*^9, 3.9536737328063374`*^9}, {3.9536984839976387`*^9, 
  3.95369848601481*^9}, {3.953698571377606*^9, 3.953698590805468*^9}, {
  3.953698642470851*^9, 3.953698642962296*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"a98ffb52-31b3-4545-946e-949f0a195286"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "the", " ", "computational", " ", "basis", " ", 
    RowBox[{"(", 
     RowBox[{"list", " ", "of", " ", "bit", " ", "strings"}], ")"}]}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"basis", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "basis", " ", "will", " ", "contain", " ", "16", " ", 
      "elements"}], ",", 
     RowBox[{
      RowBox[{"each", " ", "representing", " ", "a", " ", "state"}], "|", 
      "s1"}], ",", "s2", ",", "s3", ",", 
     RowBox[{"s4", ">"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "a", " ", "given", " ", "binary", " ", "state", " ", 
     RowBox[{"(", "list", ")"}], " ", "to", " ", "an", " ", "integer", " ", 
     "index"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ToIndex", "[", "state_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"FromDigits", "[", 
       RowBox[{"state", ",", "2"}], "]"}], "+", "1"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "each", " ", "basis", " ", "state"}], ",", 
     RowBox[{
     "find", " ", "the", " ", "index", " ", "of", " ", "its", " ", 
      "reflection"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"permutation", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ToIndex", "[", 
        RowBox[{"Reverse", "[", 
         RowBox[{"basis", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "the", " ", "mapping", " ", "into", " ", "a", " ", 
     "permutation", " ", "cycles", " ", "object"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"permCycles", "=", 
     RowBox[{"PermutationCycles", "[", "permutation", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "reflection", " ", "symmetry", " ", 
     "operator", " ", "as", " ", "a", " ", "16", "x16", " ", "permutation", 
     " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", 
     RowBox[{"PermutationMatrix", "[", 
      RowBox[{"permCycles", ",", 
       RowBox[{"2", "^", "L"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.953669659540325*^9, 3.9536696640707912`*^9}, {
  3.953673967590706*^9, 3.953673967904294*^9}, {3.953675535999295*^9, 
  3.953675536074444*^9}, {3.9536757573573513`*^9, 3.9536757573992968`*^9}, {
  3.9536758317588797`*^9, 3.953675839116808*^9}, {3.953693921823003*^9, 
  3.953693923576749*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"3d682cd4-3ae5-454c-bdc8-1f832280c66b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evalR", ",", "evecR"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "R", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evenBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "evenIndices", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "oddIndices", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.953671686288088*^9, 3.953671707515213*^9}, {
  3.953675667070992*^9, 3.953675669792479*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"e28ed3c3-55db-47f6-9bb8-721cb4a6dad1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Form", " ", "the", " ", "change"}], "-", "of", "-", 
    RowBox[{
    "basis", " ", "matrix", " ", "for", " ", "the", " ", "even", " ", 
     "sector"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Beven", "=", 
     RowBox[{"Transpose", "[", "evenBasis", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "projected", " ", "even", " ", "sector", " ", "Hamiltonian", 
     " ", "is", " ", 
     RowBox[{"then", ":"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Heven", "=", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H", ".", 
      "Beven"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Similarly", " ", "for", " ", "the", " ", "odd", " ", "sector"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Bodd", "=", 
     RowBox[{"Transpose", "[", "oddBasis", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Hodd", "=", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H", ".", 
      "Bodd"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.953693932941841*^9, 3.953693936538931*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"c0c6cc42-e80d-4894-80b5-deff7bdb8091"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Peven", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", 
    RowBox[{"N", "[", "R", "]"}], ".", "Beven"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Podd", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "R", ".", 
    "Bodd"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.953676471151516*^9, 3.953676496799691*^9}, {
   3.9536766353508883`*^9, 3.9536766355589447`*^9}, 
   3.95369394059112*^9},ExpressionUUID->"46fd5341-5a1c-4462-8031-\
30c0a6b0099e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", "Heven", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", "Hodd", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.953667504402446*^9, 3.953667504864674*^9}, {
  3.9536675656571608`*^9, 3.95366756635154*^9}, {3.953673704166019*^9, 
  3.953673727567513*^9}, {3.953675899874839*^9, 3.953675905711369*^9}, {
  3.9536759543381987`*^9, 3.953675955314007*^9}, {3.953676034968659*^9, 
  3.9536760352994337`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"a75172f2-a7d0-4e31-9252-a7c487dbf6ec"],

