Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "haar", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haar", "[", "L_Integer", "]"}], ":=", 
   RowBox[{"Normalize", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", "]"}], "]"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", "]"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"2", "^", "L"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "VNentropy", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", 
    RowBox[{"0", "|", "0."}], "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "x"}], "*", 
    RowBox[{"Log", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "sdiag", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sdiag", "[", 
    RowBox[{"L_", ",", "La_", ",", "Lb_", ",", "ini_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"state", "=", 
        RowBox[{"Dyad", "[", "ini", "]"}]}], ",", 
       RowBox[{"dima", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "La", ")"}]}]}], ",", 
       RowBox[{"dimb", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "Lb", ")"}]}]}], ",", "rho"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rho", "=", 
       RowBox[{"MatrixPartialTrace", "[", 
        RowBox[{"state", ",", "2", ",", 
         RowBox[{"{", 
          RowBox[{"dima", ",", "dimb"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Total", "[", 
       RowBox[{"Map", "[", 
        RowBox[{"VNentropy", ",", 
         RowBox[{"Sort", "[", 
          RowBox[{"Chop", "[", 
           RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}], "]"}]}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pageEntropy", "[", 
    RowBox[{"La_", ",", "Lb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"PolyGamma", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "^", "La"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"2", "^", "Lb"}], ")"}]}], "+", "1"}]}], "]"}], "-", 
    RowBox[{"PolyGamma", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "Lb"}], ")"}], "+", "1"}]}], "]"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "La"}], ")"}], "-", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"2", "^", "Lb"}], ")"}]}], ")"}]}]}]}], ";"}]}], "Input",
