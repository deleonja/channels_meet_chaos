702c1b27bec6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", "2.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"IsingNNOpenHamiltonian", "[", 
    RowBox[{"h", ",", "g", ",", "J", ",", "L"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transform", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"evenEigenvectors", ",", "oddEigenvectors"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newH", "=", 
   RowBox[{"transform", ".", "H", ".", 
    RowBox[{"ConjugateTranspose", "[", "transform", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenH", "=", 
   RowBox[{"newH", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", 
       RowBox[{"Length", "[", "evenEigenvectors", "]"}]}], ",", 
      RowBox[{"1", ";;", 
       RowBox[{"Length", "[", "evenEigenvectors", "]"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oddH", "=", 
   RowBox[{"newH", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "evenEigenvectors", "]"}], "+", "1"}], ";;", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "evenEigenvectors", "]"}], "+", "1"}], ";;", 
       RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evenval", ",", "evenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", "evenH", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"oddval", ",", "oddvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", "oddH", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9532822033207016`*^9, 3.9532822081124306`*^9}, {
