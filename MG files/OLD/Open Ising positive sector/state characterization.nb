Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hx", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hz", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"IsingNNOpenHamiltonian", "[", 
    RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenval", ",", "eigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"N", "[", "H", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"2", "^", "L"}]}], ";"}]}], "Input",
