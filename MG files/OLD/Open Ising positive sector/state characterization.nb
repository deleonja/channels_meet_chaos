           RowBox[{"Black", ",", 
            RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
            RowBox[{"Style", "[", "\"\<Svn(t)\>\"", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
