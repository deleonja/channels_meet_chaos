Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"FULL", " ", "STATES"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"productstate2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RandomChainProductState", "[", "L", "]"}], ",", "2000"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iprs", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Quiet", "[", 
