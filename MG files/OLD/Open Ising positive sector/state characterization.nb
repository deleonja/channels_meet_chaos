             RowBox[{
             "\"\<RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\), IPR = \>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"sorted", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"final", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"{", 
         RowBox[{"plot", ",", 
          RowBox[{"LogLinearPlot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", 
               RowBox[{"2", "^", "La"}]}], ")"}], "^", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"tlist", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"tlist", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"LogLinearPlot", "[", 
           RowBox[{"0.5", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"tlist", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
