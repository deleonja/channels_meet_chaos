Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Lb", "=", 
       RowBox[{"L", "-", "La"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]", "=", 
       RowBox[{"productstates", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rho", "=", 
       RowBox[{"MatrixPartialTrace", "[", 
        RowBox[{
         RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "La"}], ",", 
           RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
          RowBox[{"2", "^", 
           RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"H", "=", 
       RowBox[{"IsingNNOpenHamiltonian", "[", 
        RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Eigensystem", "[", "H", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{"Transpose", "[", "eigenvecs", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Pinv", "=", 
       RowBox[{"Conjugate", "[", "eigenvecs", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ClearAll", "[", "U", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"U", "[", "t_", "]"}], ":=", 
       RowBox[{"P", ".", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], "*", "eigenvals", "*", "t"}], "]"}], "]"}], 
        ".", "Pinv"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"chois", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"ChoiMatrix", "[", 
          RowBox[{
           RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "tlist"}], "}"}], ",", 
         RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"purity", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
         RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plot", "=", 
       RowBox[{"ListLogLinearPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
         RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<L = \>\"", "<>", 
             RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
             RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
             RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
             RowBox[{"ToString", "[", "hz", "]"}], "<>", 
             "\"\<,RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",", 
            "30", ",", "Black"}], "]"}]}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"GridLines", "->", "None"}], ",", 
         RowBox[{"FrameStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", 
            RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
            RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], 
         ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"colorMapping", "[", 
            RowBox[{"sorted", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
