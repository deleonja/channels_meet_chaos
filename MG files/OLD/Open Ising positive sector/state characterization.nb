           RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Purple", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], 
   "]"}]}]}], "Input",
