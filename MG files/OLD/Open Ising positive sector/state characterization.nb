Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"purity", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{"Tr", "[", 
       RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"schmidts", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", "i", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"delta", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "^", "2"}], ")"}], "-", 
          RowBox[{"1", "/", "8"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "i", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "schmidts"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plot", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tlist", ",", "delta"}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<L = \>\"", "<>", 
         RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
         RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
         RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
         RowBox[{"ToString", "[", "hz", "]"}], "<>", 
         "\"\<, RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",", "30",
         ",", "Black"}], "]"}]}], ",", 
     RowBox[{"Joined", "->", 
      RowBox[{"{", 
       RowBox[{"True", ",", "True"}], "}"}]}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"GridLines", "->", "None"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
        RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], ",", 
     
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"colorMapping", "[", 
          RowBox[{"sorted", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"colorMapping", "[", 
           RowBox[{"sorted", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "Dashed"}], "]"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
         "\"\<RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\), IPR = \>\"", "<>", 
          
          RowBox[{"ToString", "[", 
           RowBox[{"sorted", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"final", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{"plot", ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"2", "^", "La"}]}], ")"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"tlist", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"tlist", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{"0.5", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"tlist", "[", 
