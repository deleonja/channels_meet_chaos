     RowBox[{
      RowBox[{"Min", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"1", "/", "#"}]}], "}"}], "]"}]}], "&"}], "[", 
     RowBox[{"Ratios", "[", 
      RowBox[{"Differences", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
