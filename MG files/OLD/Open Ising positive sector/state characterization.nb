Cell[BoxData[{
 RowBox[{
  RowBox[{"Lb", "=", 
   RowBox[{"L", "-", "La"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", "=", 
   RowBox[{"productstates", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"MatrixPartialTrace", "[", 
    RowBox[{
     RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", "La"}], ",", 
       RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"IsingNNOpenHamiltonian", "[", 
    RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", "H", "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Transpose", "[", "eigenvecs", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pinv", "=", 
   RowBox[{"Conjugate", "[", "eigenvecs", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "U", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", "t_", "]"}], ":=", 
   RowBox[{"P", ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "eigenvals", "*", "t"}], "]"}], "]"}], ".", 
    "Pinv"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chois", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"ChoiMatrix", "[", 
      RowBox[{
       RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tlist"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.960443166761697*^9, 3.960443168395274*^9}, 
   3.960443787891986*^9, 3.960444195013043*^9, {3.960444284372818*^9, 
