Cell["Ising symmetric states", "Title",
 CellChangeTimes->{{3.9404826242543716`*^9, 3.9404826315567093`*^9}, {
  3.952560707120246*^9, 3.9525607098731537`*^9}, {3.952563499033996*^9, 
