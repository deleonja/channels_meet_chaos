        RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
        RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], ",", 
     
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"colorMapping", "[", 
          RowBox[{"sorted", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"colorMapping", "[", 
           RowBox[{"sorted", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "Dashed"}], "]"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{
         "\"\<RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\), IPR = \>\"", "<>", 
          
          RowBox[{"ToString", "[", 
           RowBox[{"sorted", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"final", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{"plot", ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
