Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"KroneckerVectorProduct", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"a", ",", "b"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BlochVector", "[", "\[Rho]_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"Pauli", "[", "#", "]"}], ".", "\[Rho]"}], "]"}], "&"}], "/@", 
    
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Parity", "[", 
    RowBox[{"\[Psi]_", ",", "L_"}], "]"}], ":=", 
   RowBox[{"\[Psi]", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "#", "]"}], ",", "2"}], "]"}], "+", "1"}], 
       "&"}], "/@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Braket", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Conjugate", "[", "a", "]"}], ".", "b"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MeanLevelSpacingRatio", "[", "eigenvalues_", "]"}], ":=", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Min", "/@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"1", "/", "#"}]}], "}"}], "]"}]}], "&"}], "[", 
     RowBox[{"Ratios", "[", 
      RowBox[{"Differences", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "SurvivalProbability", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SurvivalProbability", "[", 
    RowBox[{"\[Psi]t_", ",", "\[Psi]0_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Braket", "[", 
      RowBox[{"\[Psi]0", ",", "\[Psi]t"}], "]"}], "]"}], "^", "2"}]}], 
  ";"}]}], "Input",
