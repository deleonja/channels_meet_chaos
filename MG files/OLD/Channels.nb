            RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", "i"}], "]"}], "^", 
        "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "\[Psi]ct"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
