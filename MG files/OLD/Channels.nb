  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"emin", ",", "emax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "energiesa", "]"}], ",", 
       RowBox[{"Max", "[", "energiesa", "]"}]}], "}"}]}], ";"}], "\n", 
