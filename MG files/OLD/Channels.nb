Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Kernel", " ", "Density", " ", "Estimate", " ", "for", " ", "smoother", 
    " ", "DOS"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dosDensity", "=", 
     RowBox[{"SmoothKernelDistribution", "[", "eigenval", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "smoothed", " ", "density", " ", "of", " ", 
     "states"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{"dosDensity", ",", "e"}], "]"}], ",", 
