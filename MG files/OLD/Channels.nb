Cell[BoxData[
 RowBox[{"ListLogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"\[Psi]a", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", "i"}], "]"}], "^", 
        "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "\[Psi]at"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"\[Psi]b", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", "i"}], "]"}], "^", 
        "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "\[Psi]bt"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
