Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "energy", " ", "range", " ", "and", " ", "bin", " ", 
    "width"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"emin", ",", "emax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "eigenval", "]"}], ",", 
       RowBox[{"Max", "[", "eigenval", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"binWidth", "=", 
     RowBox[{"20", "*", 
      RowBox[{"Mean", "[", 
       RowBox[{"Differences", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{"eigenval", "+", 
          RowBox[{"Min", "[", "eigenval", "]"}]}], "]"}], "]"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "histogram", " ", "bins", " ", "for", " ", "density", " ", 
     "of", " ", "states"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DOS", "=", 
    RowBox[{"Histogram", "[", 
     RowBox[{"eigenval", ",", 
      RowBox[{"{", "binWidth", "}"}], ",", "\"\<ProbabilityDensity\>\"", ",", 
      
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"emin", ",", "emax"}], "}"}], ",", "All"}], "}"}]}], ",", 
      RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]}]], "Input",
