Cell[BoxData[{
 RowBox[{
  RowBox[{"q", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lb", "=", 
      RowBox[{"L", "-", "La"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Psi]", "=", 
        RowBox[{"RandomChainProductState", "[", "Lb", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Psi]", "=", 
        RowBox[{"haar", "[", "Lb", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"coherentstate", "[", 
       RowBox[{
        RowBox[{"haar", "[", "1", "]"}], ",", "Lb"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
         RowBox[{"2", "^", 
          RowBox[{"(", "La", ")"}]}]}], ",", 
        RowBox[{"Dyad", "[", "\[Psi]", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", "H", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"Transpose", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pinv", "=", 
      RowBox[{"Conjugate", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ClearAll", "[", "U", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "[", "t_", "]"}], ":=", 
      RowBox[{"P", ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "eigenvals", "*", "t"}], "]"}], "]"}], ".",
        "Pinv"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"chois", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ChoiMatrix", "[", 
         RowBox[{
          RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plot", "=", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<L = \>\"", "<>", 
            RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
            RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
            RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
            RowBox[{"ToString", "[", "hz", "]"}], "<>", "\"\<, \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"texts", "[", 
              RowBox[{"[", "q", "]"}], "]"}], "]"}], "<>", 
            "\"\< \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",", "30", 
           ",", "Black"}], "]"}]}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"GridLines", "->", "None"}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", 
           RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
           RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], 
        ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"colors", "[", 
             RowBox[{"[", "q", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "\"\<\!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\) \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"texts", "[", 
               RowBox[{"[", "q", "]"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"colors", "[", 
             RowBox[{"[", "q", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"final", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{"plot", ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{"0.25", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{"0.5", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Purple", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"\"\<choi_coherent_loglinear_purity_L_\>\"", "<>", 
        RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_La_\>\"", "<>", 
        RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<_J_\>\"", "<>", 
        RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<_hz_\>\"", "<>", 
        RowBox[{"ToString", "[", "hz", "]"}], "<>", "\"\<_.png\>\""}], ",", 
       "final", ",", 
       RowBox[{"ImageResolution", "->", "300"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"L", ",", "4", ",", "10", ",", "2"}], "}"}]}], "]"}], 
  ";"}]}], "Input",
