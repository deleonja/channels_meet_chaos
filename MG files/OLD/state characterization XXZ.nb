Cell[BoxData[{
 RowBox[{
  RowBox[{"list", "=", 
   RowBox[{"purity", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interpcaos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Interpolation", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "purity"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanpuritycaos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
