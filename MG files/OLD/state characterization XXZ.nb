Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"productstate2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomChainProductState", "[", "L", "]"}], ",", "1000"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iprs", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "eigenvec", "]"}], ".", "i"}], "]"}], "^",
         "4"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "productstate2"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"energies", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "i", "]"}], ".", "H", ".", "i"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "productstate2"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"energies", ",", "iprs"}], "}"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], "Input",
