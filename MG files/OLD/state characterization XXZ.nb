            RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
            RowBox[{"Style", "[", "\"\<Svn(t)\>\"", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"colorMapping", "[", 
            RowBox[{"sorted", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "productstate", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
