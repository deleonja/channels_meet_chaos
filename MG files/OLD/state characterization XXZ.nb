    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "#", "]"}], ",", "2"}], "]"}], "+", "1"}], 
       "&"}], "/@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
