             RowBox[{"ToString", "[", "\[CapitalDelta]", "]"}], "<>", 
             "\"\<, \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\) = RPS\>\""}], ",",
             "30", ",", "Black"}], "]"}]}], ",", 
