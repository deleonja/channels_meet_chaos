    RowBox[{
     RowBox[{"{", 
      RowBox[{"Emin", ",", "Emax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "sorted", "]"}], ",", 
       RowBox[{"Max", "[", "sorted", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
      RowBox[{
      "Define", " ", "a", " ", "function", " ", "to", " ", "map", " ", "an", 
       " ", "energy", " ", "value", " ", "to", " ", "a", " ", "temperature"}],
       "-", 
      RowBox[{"like", " ", "color"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"colorMapping", "[", "e_", "]"}], ":=", 
