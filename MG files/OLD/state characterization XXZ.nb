Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "Pauli", " ", "matrices", " ", "and", " ", "identity"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sigmaX", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigmaY", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "I"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigmaZ", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"id2", "=", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Define", " ", "spin"}], "-", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "operators", " ", "with", " ", 
       "\[HBar]"}]}], "=", "1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sx", "=", 
     RowBox[{"sigmaX", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Sy", "=", 
     RowBox[{"sigmaY", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Sz", "=", 
     RowBox[{"sigmaZ", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Splus", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"sigmaX", "+", 
        RowBox[{"I", "*", "sigmaY"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Sminus", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"sigmaX", "-", 
        RowBox[{"I", "*", "sigmaY"}]}], ")"}], "/", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "function", " ", "to", " ", "create", " ", "an", 
     " ", "operator", " ", "acting", " ", "on", " ", "site", " ", "i", " ", 
     "of", " ", "a", " ", "chain", " ", "of", " ", "length", " ", "L"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"OpOnSite", "[", 
      RowBox[{"op_", ",", "i_", ",", "L_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"j", "==", "i"}], ",", "op", ",", "id2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "L"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "periodic", " ", 
      RowBox[{"index", ":", 
       RowBox[{
        RowBox[{"if", " ", "i"}], ">", "L"}]}]}], ",", 
     RowBox[{"wrap", " ", "around"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"modIndex", "[", 
      RowBox[{"i_", ",", "L_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"i", ">", "L"}], ",", 
       RowBox[{"i", "-", "L"}], ",", "i"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Set", " ", "chain", " ", "length"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "4"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Set", " ", "Hamiltonian", " ", 
     RowBox[{"parameters", ":", 
      RowBox[{"J", " ", "and", " ", "anisotropy", " ", "Delta"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Delta", "=", "0.5"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "XXZ", " ", "Hamiltonian", " ", "with", " ",
      "periodic", " ", "boundary", " ", "conditions"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sp", ",", "sm", ",", "sz1", ",", "sz2"}], "}"}], ",", 
         RowBox[{
          RowBox[{"sp", "=", 
           RowBox[{"OpOnSite", "[", 
            RowBox[{"Splus", ",", "i", ",", "L"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sm", "=", 
           RowBox[{"OpOnSite", "[", 
            RowBox[{"Sminus", ",", "i", ",", "L"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sz1", "=", 
           RowBox[{"OpOnSite", "[", 
            RowBox[{"Sz", ",", "i", ",", "L"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sz2", "=", 
           RowBox[{"OpOnSite", "[", 
            RowBox[{"Sz", ",", 
             RowBox[{"modIndex", "[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "L"}], "]"}], ",", "L"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"J", "/", "2"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sp", ".", 
               RowBox[{"OpOnSite", "[", 
                RowBox[{"Sminus", ",", 
                 RowBox[{"modIndex", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "1"}], ",", "L"}], "]"}], ",", "L"}], 
                "]"}]}], "+", 
              RowBox[{
               RowBox[{"OpOnSite", "[", 
                RowBox[{"Sminus", ",", "i", ",", "L"}], "]"}], ".", 
               RowBox[{"OpOnSite", "[", 
                RowBox[{"Splus", ",", 
                 RowBox[{"modIndex", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "1"}], ",", "L"}], "]"}], ",", "L"}], 
                "]"}]}]}], ")"}]}], "+", 
           RowBox[{"Delta", " ", 
            RowBox[{"(", 
             RowBox[{"sz1", ".", "sz2"}], ")"}]}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "L"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Sz", " ", "operator"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SzTotal", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"OpOnSite", "[", 
        RowBox[{"Sz", ",", "i", ",", "L"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "L"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Diagonalize", " ", "SzTotal", " ", "to", " ", "get", " ", "its", " ", 
     "eigenvalues", " ", "and", " ", "eigenvectors"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"szEigenVals", ",", "szEigenVecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "SzTotal", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Eigenvalues of SzTotal:\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Sort", "[", "szEigenVals", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "helper", " ", "function", " ", "to", " ", 
     "extract", " ", "a", " ", "submatrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "Submatrix", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Submatrix", "[", 
      RowBox[{"A_", ",", "rows_", ",", "cols_"}], "]"}], ":=", 
     RowBox[{"A", "[", 
      RowBox[{"[", 
       RowBox[{"rows", ",", "cols"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Group", " ", "the", " ", "basis", " ", "indices", " ", "according", " ", 
     "to", " ", "the", " ", "eigenvalues", " ", "of", " ", "SzTotal"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"groupIndices", "=", 
     RowBox[{"GatherBy", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "szEigenVals", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"szEigenVals", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Indices grouped by SzTotal eigenvalue:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "groupIndices", "]"}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Change", " ", 
     RowBox[{"basis", ":", 
      RowBox[{
      "transform", " ", "H", " ", "to", " ", "the", " ", "eigenbasis", " ", 
       "of", " ", "SzTotal"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hdiag", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "szEigenVecs", "]"}], ".", "H", ".",
        "szEigenVecs"}], "//", "Chop"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "and", " ", "display", " ", "the", " ", "Hamiltonian", 
     " ", "blocks", " ", "corresponding", " ", "to", " ", "each", " ", 
     "SzTot", " ", "sector"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blocks", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"indices", "=", 
           RowBox[{"groupIndices", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Submatrix", "[", 
          RowBox[{"Hdiag", ",", "indices", ",", "indices"}], "]"}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "groupIndices", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Hamiltonian blocks by SzTotal sector:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"TableForm", "[", "blocks", "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.952734474421256*^9, 3.952734474426223*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"d93499a7-dcc8-4576-9b54-901ff4d7fddd"],

