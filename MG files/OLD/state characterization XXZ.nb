   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Emin", ",", "Emax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "sorted", "]"}], ",", 
       RowBox[{"Max", "[", "sorted", "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
      RowBox[{
      "Define", " ", "a", " ", "function", " ", "to", " ", "map", " ", "an", 
       " ", "energy", " ", "value", " ", "to", " ", "a", " ", "temperature"}],
       "-", 
      RowBox[{"like", " ", "color"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"colorMapping", "[", "e_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<FruitPunchColors\>\"", "]"}], "[", 
      RowBox[{"Rescale", "[", 
       RowBox[{"e", ",", 
        RowBox[{"{", 
         RowBox[{"Emin", ",", "Emax"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "plot", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"fakesvn", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
