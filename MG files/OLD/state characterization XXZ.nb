Cell[CellGroupData[{

Cell["Antiflatness", "Chapter",
 CellChangeTimes->{{3.952814101280096*^9, 
  3.952814103439137*^9}},ExpressionUUID->"550bcfc0-9b5e-4d75-a109-\
f9cff5b2dad4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rhoa", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoa", "[", 
    RowBox[{
    "L_", ",", "La_", ",", "Lb_", ",", "ini_", ",", "eigenval_", ",", 
     "eigenvec_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"state", "=", 
        RowBox[{"StateEvolution", "[", 
         RowBox[{"t", ",", "ini", ",", "eigenval", ",", "eigenvec"}], "]"}]}],
        ",", "rho", ",", "\[Lambda]", ",", "purity", ",", 
       RowBox[{"dima", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "La", ")"}]}]}], ",", 
       RowBox[{"dimb", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "Lb", ")"}]}]}], ",", "vn"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MatrixPartialTrace", "[", 
      RowBox[{
       RowBox[{"Dyad", "[", "state", "]"}], ",", "2", ",", 
       RowBox[{"{", 
        RowBox[{"dima", ",", "dimb"}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "antif", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"antif", "[", "rho_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"rho", ",", "3"}], "]"}], "]"}], "-", 
    RowBox[{"Tr", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"rho", ",", "2"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.952664035368025*^9, 3.952664050875452*^9}, {
  3.952814919007887*^9, 3.952814920731523*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"c5a85642-7b2f-4437-89af-8c682495a0b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rhos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"rhoa", "[", 
         RowBox[{
         "L", ",", "La", ",", "Lb", ",", "i", ",", "eigenval", ",", 
          "eigenvec", ",", "t"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tlist"}], "}"}], ",", 
       RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "productstate"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"purity", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tlist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"j", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ".", 
           RowBox[{"j", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tlist", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "rhos"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flatness", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tlist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"Chop", "[", 
          RowBox[{"antif", "[", 
           RowBox[{"j", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tlist", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "rhos"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.952664081096776*^9, 3.952664145311661*^9}, {
  3.9526656488805647`*^9, 3.952665664909235*^9}, {3.952815921106583*^9, 
