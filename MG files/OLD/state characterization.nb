Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{
    "Determine", " ", "the", " ", "overall", " ", "energy", " ", "range"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sorted", "=", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", 
         RowBox[{"-", "1"}], ";;", "200"}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Emin", ",", "Emax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Min", "[", "sorted", "]"}], ",", 
       RowBox[{"Max", "[", "sorted", "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
      RowBox[{
      "Define", " ", "a", " ", "function", " ", "to", " ", "map", " ", "an", 
       " ", "energy", " ", "value", " ", "to", " ", "a", " ", "temperature"}],
       "-", 
      RowBox[{"like", " ", "color"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"colorMapping", "[", "e_", "]"}], ":=", 
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<FruitPunchColors\>\"", "]"}], "[", 
      RowBox[{"Rescale", "[", 
       RowBox[{"e", ",", 
        RowBox[{"{", 
         RowBox[{"Emin", ",", "Emax"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "plot", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ListLogLinearPlot", "[", 
        RowBox[{
         RowBox[{"fakesvn", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<L = \>\"", "<>", 
             RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
             RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
             RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
             RowBox[{"ToString", "[", "hz", "]"}], "<>", 
             "\"\<, \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\) = RPS\>\""}], ",",
             "30", ",", "Black"}], "]"}]}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"GridLines", "->", "None"}], ",", 
         RowBox[{"FrameStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", 
            RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
            RowBox[{"Style", "[", "\"\<Svn(t)\>\"", "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"colorMapping", "[", 
            RowBox[{"sorted", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "productstate", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{"{", 
       RowBox[{"plots", ",", 
        RowBox[{"LogLinearPlot", "[", 
         RowBox[{
          RowBox[{"pageEntropy", "[", 
           RowBox[{"La", ",", "Lb"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Min", "[", "tlist", "]"}], ",", 
            RowBox[{"Max", "[", "tlist", "]"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed"}], "]"}], "}"}]}]}], "]"}]}], 
       "}"}], "]"}], ",", 
     RowBox[{"BarLegend", "[", 
      RowBox[{
       RowBox[{"{", 
