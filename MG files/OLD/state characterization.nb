Cell[BoxData[
 RowBox[{
  RowBox[{"Lb", "=", 
   RowBox[{"L", "-", "La"}]}], ";", "\[IndentingNewLine]", 
  RowBox[{"\[Psi]", "=", 
   RowBox[{"productstate", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
  RowBox[{"rho", "=", 
   RowBox[{"MatrixPartialTrace", "[", 
    RowBox[{
     RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", "La"}], ",", 
       RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], ";", 
  "\[IndentingNewLine]", 
  RowBox[{"A", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], ";"}]], "Input",Ex\
pressionUUID->"bfdbc7fb-de99-4133-85e3-8fca01ddfb42"],

Cell[BoxData[
 RowBox[{
  RowBox[{"allplots", "=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952552921776589*^9, 3.952552925421239*^9}},
 CellLabel->
  "In[251]:=",ExpressionUUID->"9a45050e-85a2-4f6b-8ad4-6cb008abf2c3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lb", "=", 
      RowBox[{"L", "-", "La"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"productstate", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rho", "=", 
      RowBox[{"MatrixPartialTrace", "[", 
       RowBox[{
        RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "^", "La"}], ",", 
          RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
         RowBox[{"2", "^", 
          RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", "H", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"Transpose", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pinv", "=", 
      RowBox[{"Conjugate", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ClearAll", "[", "U", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "[", "t_", "]"}], ":=", 
      RowBox[{"P", ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "eigenvals", "*", "t"}], "]"}], "]"}], ".",
        "Pinv"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"chois", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ChoiMatrix", "[", 
         RowBox[{
          RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plot", "=", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<L = \>\"", "<>", 
            RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
            RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
            RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
            RowBox[{"ToString", "[", "hz", "]"}], "<>", 
            "\"\<,RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",", 
           "30", ",", "Black"}], "]"}]}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"GridLines", "->", "None"}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", 
           RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
           RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], 
        ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"colorMapping", "[", 
           RowBox[{"sorted", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "\"\<RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\), IPR = \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"sorted", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}], "}"}]}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"final", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{"plot", ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"2", "^", "La"}]}], ")"}], "^", "2"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{"0.5", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Purple", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"\"\<choi_RPS_\>\"", "<>", 
