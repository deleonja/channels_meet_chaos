   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"Pauli", "[", "#", "]"}], ".", "\[Rho]"}], "]"}], "&"}], "/@", 
    
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Parity", "[", 
