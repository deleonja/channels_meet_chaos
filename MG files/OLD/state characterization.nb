   RowBox[{"\[Psi]", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "#", "]"}], ",", "2"}], "]"}], "+", "1"}], 
       "&"}], "/@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Braket", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Conjugate", "[", "a", "]"}], ".", "b"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MeanLevelSpacingRatio", "[", "eigenvalues_", "]"}], ":=", 
   RowBox[{"Mean", "[", 
